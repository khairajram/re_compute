# ==========================================
# ReCompute Monorepo Environment Variables
# ==========================================

# ------------------------------------------
# Database Configuration (Used by packages/db & backend)
# ------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recompute_db?schema=public"

# ------------------------------------------
# Backend (apps/backend)
# ------------------------------------------
NODE_ENV="development"
PORT="4000"
FRONTEND_URL="http://localhost:3000"
LOG_LEVEL="info"

# Authentication (JWT & Google OAuth)
JWT_SECRET="your_super_secret_jwt_key_here"
JWT_EXPIRES_IN="20d"
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"

# ------------------------------------------
# WebSocket Backend (apps/ws-backend)
# ------------------------------------------
# Note: if PORT is set to 4000 above and ws-backend runs on same env, you might need a different var or run in different env.
# In codebase, ws-backend uses PORT || 8080.
# WS_PORT="8080"

# ------------------------------------------
# Host Agent (apps/host-agent)
# ------------------------------------------
WS_SERVER_URL="ws://localhost:8080"
MACHINE_ID="machine-1"

# ------------------------------------------
# Frontend (apps/app_frontend)
# ------------------------------------------
# These must start with NEXT_PUBLIC_ to be exposed to the browser.
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
NEXT_PUBLIC_WEBSOCKET_URL="ws://localhost:8080"
