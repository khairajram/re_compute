    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@repo/typescript-config": "workspace:*",
    "pg": "^8.20.0",
    "prisma": "^7.7.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "dotenv": "^17.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
}
