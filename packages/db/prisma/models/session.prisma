model Session {
  id        String      @id @default(uuid())
  pricePerHour Float
  totalCost Float?

  user      User     @relation(fields: [userId], references: [id])
  userId    Int

  machine   HostMachine @relation(fields: [machineId], references: [id])
  machineId String

  startTime DateTime @default(now())
  endTime   DateTime?

  status    SessionStatus

  jobs      Job[]
  resourceUsage      ResourceUsage[]
  payment   Payment?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([machineId])
  @@index([status])
}

enum SessionStatus {
    ACTIVE
    COMPLETED
    PENDING
    CANCELLED
    FAILED
}